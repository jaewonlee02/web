<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>
        <%= name %> - 포트폴리오
    </title>
    <link rel="stylesheet" href="/style.css">

</head>

<body>
    <header>
        <a href="mailto:ljw090302@gmail.com">이메일 보내기</a>
        <h1>안녕하세요, 정보통신공학과 <%= name %>입니다!</h1>
        <button id="darkBtn" >다크모드 켜기/끄기</button>
    </header>

    <main>
        <section class="card">
            <h2>기본 정보 </h2>
            <ul>
                <!-- EJS 변수 활용 -->
                <li><strong>이름:</strong>
                    <%= name %> (<%= age %>세)
                </li>
                <li><strong>전공:</strong>
                    <%= major %>
                </li>
                <li><strong>일상:</strong>
                    <%= daily %>
                </li>
                <li><strong>목표:</strong> BOB 들어가기 </li>
            </ul>
        </section>

        <section class="card">
            <h2>기술 스택 및 관심 분야</h2>
            <ul>
                <li><strong>언어:</strong>
                    <% for(let i=0; i < skills.length; i++) { %>
                        <%= skills[i] %>
                            <%= i !==skills.length - 1 ? ', ' : '' %>
                                <% } %>
                </li>
                <li><strong>네트워크/보안:</strong> Wireshark 기반 패킷 분석, TCP/IP 이해</li>
                <li><strong>IoT/하드웨어:</strong> Arduino, Raspberry Pi, InfluxDB, Grafana 기반 환경 구축 경험</li>
            </ul>
        </section>

        <section class="card">
            <h2>취미 & 여가</h2>
            <ul>
                <% hobbies.forEach(function(hobby) { %>
                    <li>
                        <%= hobby %>
                    </li>
                    <% }) %>
            </ul>
        </section>

        <button id="foodBtn">좋아하는음식</button>
        <button id="guestBtn">메세지 남기기</button>

        <div id="guestMsg" style="text-align: center; margin-top: 15px; font-weight: bold; color: #2980b9;"></div>

    </main>
    <div class="link">
        <a href="https://github.com/jaewonlee02" target="_blank" class="github">
