    </div>

<script>
        window.onload = function () {
            const foodBtn = document.querySelector('#foodBtn');
            foodBtn.addEventListener('click', function () {
                const passwd = prompt('비밀번호를 입력해주세요', '생일(MMDD)');
                if (passwd == "0309") {
                    alert(`좋아하는 음식은 집밥입니다~`);
                } else {
                    alert(`알려줄 수 없어요`);
                }
            });

            const themeBtn = document.querySelector('#darkBtn');
            themeBtn.addEventListener('click', function () {
                document.body.classList.toggle('darkMode');
            });


            const guestBtn = document.querySelector('#guestBtn');
            const msgBox = document.querySelector('#guestMsg');

            guestBtn.addEventListener('click', function () {
                const guestName = prompt('성함을 입력해주세요!', '익명');

                if (guestName) {
                    const message = prompt(`${guestName}님, 작성하고싶은 말 적어주세요`);

                    if (message) {
                        msgBox.innerHTML = `${guestName}님의 메세지: "${message}"`;
                        alert('등록되었습니다. ');
                    }
                }
            });
        };
    </script>
</body>

</html>